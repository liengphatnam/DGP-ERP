@page
@{
    ViewData["Title"] = "Inventory";
}

<div class="page-header">
    <h3>Inventory</h3>
    <button class="btn btn-primary">Stock adjustment</button>
</div>

<div class="card-erp table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Location</th>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Type</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>WH-01</td>
                    <td>HN001</td>
                    <td>2,400</td>
                    <td>FG</td>
                    <td><span class="badge-status success">Available</span></td>
                </tr>
                <tr>
                    <td>WH-02</td>
                    <td>AS001</td>
                    <td>1,180</td>
                    <td>RM</td>
                    <td><span class="badge-status warning">Low stock</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
