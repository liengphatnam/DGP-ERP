@page
@{
    ViewData["Title"] = "Sales Orders";
}

<div class="page-header">
    <h3>Sales Orders</h3>
    <button class="btn btn-primary">Create order</button>
</div>

<div class="card-erp table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Value</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>SO-2048</td>
                    <td>Dona Green Pack</td>
                    <td>$24,800</td>
                    <td>2026-08-27</td>
                    <td><span class="badge-status success">Confirmed</span></td>
                </tr>
                <tr>
                    <td>SO-2049</td>
                    <td>Metro Pack Supply</td>
                    <td>$18,200</td>
                    <td>2026-08-30</td>
                    <td><span class="badge-status warning">In progress</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
